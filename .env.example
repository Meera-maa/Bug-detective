# Which AI backend to use.
#
# "mock" (default) — built-in offline analyzer. This is the working demo provider.
#                    No credentials needed. IBM Bob was used as the development agent
#                    to build this analyzer; it is not a callable runtime API.
# "bob"            — reserved slot for a future callable IBM AI API (currently throws).
#                    See lib/ai/bob.ts for how to connect one if it becomes available.
AI_PROVIDER=mock

# Optional tuning
# AI_TIMEOUT_MS=25000
# MOCK_DELAY_MS=700
