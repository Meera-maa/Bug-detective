# Which AI backend to use: "mock" (default, offline) or "bob" (IBM Bob, once connected in lib/ai/bob.ts)
AI_PROVIDER=mock
# Add IBM Bob credentials here (server-side only, never NEXT_PUBLIC_*), e.g. once you know the variable names Bob needs:
# BOB_API_KEY=
# Optional tuning
# AI_TIMEOUT_MS=25000
# MOCK_DELAY_MS=700
